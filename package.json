{
  "name": "al-zahra-smart-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Root orchestrator. All application tooling lives in alzhraERP/ - do not add dependencies here (husky only).",
  "scripts": {
    "dev": "npm --prefix alzhraERP run dev",
    "build": "node build.js",
    "build:analyze": "npm --prefix alzhraERP run build:analyze",
    "lint": "npm --prefix alzhraERP run lint",
    "lint:fix": "npm --prefix alzhraERP run lint:fix",
    "preview": "npm --prefix alzhraERP run preview",
    "type-check": "npm --prefix alzhraERP run type-check",
    "type-check:strict": "npm --prefix alzhraERP run type-check:strict",
    "test": "npm --prefix alzhraERP run test",
    "test:ci": "npm --prefix alzhraERP run test:ci",
    "test:ui": "npm --prefix alzhraERP run test:ui",
    "test:e2e": "npm --prefix alzhraERP run test:e2e",
    "test:e2e:ui": "npm --prefix alzhraERP run test:e2e:ui",
    "coverage": "npm --prefix alzhraERP run coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  }
}
