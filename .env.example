# Al-Zahra Smart ERP - Environment Variables
# Copy this file to .env and fill in the values

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://zzthamxjxnxzzpswllid.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- AI Configuration ---
# ⚠️ NEVER add AI keys with a VITE_ prefix — they get bundled into the browser.
# AI keys are configured ONLY server-side in Supabase Edge Functions
# (see supabase/functions/ai-proxy: OPENROUTER_API_KEY / DEEPSEEK_API_KEY).

# --- Feature Flags ---
VITE_ENABLE_AI_FEATURES=true
VITE_DEV_MODE=true

# --- Optional: Sentry for Error Tracking ---
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
